---
import Logo from '../assets/brand/melega-logo-on-dark.svg';
import CallLink from './CallLink.astro';
import { SITE } from '../config/site';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#empresa', label: 'Empresa' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 bg-melega-night/85 text-white backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="#inicio" class="shrink-0" aria-label="Melega, ir al inicio">
      <Logo aria-label="Melega" role="img" class="h-9 w-auto" />
    </a>
    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex gap-7 text-sm font-semibold text-white/80">
        {links.map((l) => <li><a href={l.href} class="transition-colors duration-150 hover:text-white">{l.label}</a></li>)}
      </ul>
    </nav>
    <CallLink location="header" variant="solid" class="px-3.5! py-2! text-sm">
      <span class="sr-only sm:not-sr-only">{SITE.phones.primary.display}</span>
    </CallLink>
  </div>
</header>
