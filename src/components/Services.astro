---
import ServiceTabs from './ServiceTabs';
import CallLink from './CallLink.astro';
import { services } from '../data/services';
---

<section id="servicios" class="bg-melega-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div data-reveal-group class="max-w-2xl">
        <p class="text-sm font-bold tracking-[0.18em] text-melega-dark uppercase">Servicios</p>
        <h2 class="mt-3 font-display text-[1.85rem] leading-none font-black sm:text-4xl tracking-[-0.02em] text-melega-ink uppercase italic [font-stretch:110%] md:text-5xl">
          ¿Qué necesitas?
        </h2>
        <p class="mt-4 text-lg text-melega-ink/70">
          Trabajamos igual de bien para una planta industrial que para tu casa o tu negocio. Elige y te contamos cómo podemos ayudarte.
        </p>
      </div>
      <div data-reveal>
        <CallLink location="services" variant="outline" class="text-melega-dark">Pide presupuesto</CallLink>
      </div>
    </div>
    <div data-reveal class="mt-10">
      <ServiceTabs client:idle groups={services} />
    </div>
  </div>
</section>
