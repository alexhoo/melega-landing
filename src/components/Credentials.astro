---
import { ShieldCheck } from 'lucide-react';
import { credentials } from '../data/credentials';
---

<section id="garantias" class="bg-melega-paper py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-bold tracking-[0.18em] text-melega-dark uppercase">Garantías</p>
    <h2 class="mt-3 max-w-2xl font-display text-4xl font-black tracking-[-0.02em] text-melega-ink uppercase italic [font-stretch:110%] md:text-5xl">
      Certificados y autorizados
    </h2>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        credentials.map((c) => (
          <li
            data-pending={c.pendingConfirmation ? '' : undefined}
            class="flex gap-3 rounded-xl border border-transparent bg-white p-4 shadow-[0_0_0_1px_rgb(0_0_0/0.05),0_1px_2px_rgb(0_0_0/0.05)]"
          >
            <ShieldCheck aria-hidden="true" size={22} strokeWidth={2} className="mt-0.5 shrink-0 text-melega-dark" />
            <div>
              <p class="font-bold text-melega-ink">{c.name}</p>
              <p class="text-sm text-melega-ink/65">{c.detail}</p>
              {c.pendingConfirmation && (
                <p class="mt-1.5 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">
                  Pendiente de confirmar
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
