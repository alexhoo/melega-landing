---
import CallLink from './CallLink.astro';
---

<div
  data-mobile-call-bar
  class="fixed inset-x-0 bottom-0 z-50 bg-gradient-to-t from-melega-night via-melega-night/90 to-transparent px-3 pt-6 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden"
>
  <CallLink location="mobile-bar" class="w-full justify-center py-3.5 text-lg shadow-[0_8px_24px_rgb(0_0_0/0.4)]">
    Llamar ahora
  </CallLink>
</div>
