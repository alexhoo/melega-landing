---
import { SITE } from '../config/site';
---

<section id="llamar" class="bg-melega-light py-16 text-melega-night md:py-20">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-4 sm:px-6 md:flex-row md:items-center">
    <div>
      <h2 class="font-display text-[1.85rem] leading-none font-black sm:text-4xl tracking-[-0.02em] uppercase italic [font-stretch:110%] md:text-5xl">
        ¿Hablamos de tu proyecto?
      </h2>
      <p class="mt-3 text-lg font-medium text-melega-night/80">Cuéntanos qué necesitas y te asesoramos sin compromiso.</p>
    </div>
    <a
      href={SITE.phones.primary.href}
      data-call="final"
      class="inline-flex shrink-0 items-center gap-3 rounded-xl bg-melega-night px-7 py-4 font-display text-2xl whitespace-nowrap font-black text-white italic transition-[scale,background-color] duration-150 ease-out hover:bg-melega-deep motion-safe:active:scale-[0.96]"
    >
      {SITE.phones.primary.display}
    </a>
  </div>
</section>
