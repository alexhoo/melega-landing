---
import Logo from '../assets/brand/melega-logo-on-dark.svg';
import CallLink from './CallLink.astro';
import { SITE } from '../config/site';

const { address } = SITE;
---

<footer class="bg-melega-deep text-sm text-white/70">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <Logo aria-label="Melega" role="img" class="h-9 w-auto" />
      <p class="mt-3">{SITE.legalName} · {SITE.tagline}</p>
    </div>
    <address class="not-italic">
      {address.street}<br />
      {address.area}<br />
      {address.postalCode} {address.city} ({address.region})
    </address>
    <div class="flex flex-col gap-1.5">
      <p>Teléfono: <CallLink location="footer" variant="bare" class="text-white" /></p>
      <p>Móvil: <CallLink phone="secondary" location="footer-mobile" variant="bare" class="text-white" /></p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-4 px-4 py-6 sm:px-6">
      <p>© {new Date().getFullYear()} {SITE.legalName}</p>
      <nav aria-label="Legal" class="flex gap-6">
        <a href="/aviso-legal" class="hover:text-white">Aviso legal</a>
        <a href="/privacidad" class="hover:text-white">Privacidad</a>
      </nav>
    </div>
  </div>
</footer>
