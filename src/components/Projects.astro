---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
---

<section id="proyectos" class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-bold tracking-[0.18em] text-melega-dark uppercase">Proyectos</p>
    <h2 class="mt-3 max-w-2xl font-display text-4xl font-black tracking-[-0.02em] text-melega-ink uppercase italic [font-stretch:110%] md:text-5xl">
      Trabajos que hablan por nosotros
    </h2>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        projects.map((p) => (
          <article>
            {p.image && (
              <Image
                src={p.image}
                alt={p.imageAlt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 270px, (min-width: 640px) 45vw, 92vw"
                class="aspect-[4/3] w-full rounded-xl object-cover outline-1 -outline-offset-1 outline-black/10"
              />
            )}
            <p class="mt-4 text-xs font-bold tracking-[0.14em] text-melega-dark uppercase">
              {p.client} · {p.place}
            </p>
            <h3 class="mt-1.5 text-lg leading-snug font-bold text-melega-ink">{p.title}</h3>
          </article>
        ))
      }
    </div>
  </div>
</section>
